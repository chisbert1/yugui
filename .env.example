# ==============================================================================
# Yu-Gi-Oh! Collector — Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="Yu-Gi-Oh! Collector API"
APP_VERSION=1.0.0
DEBUG=true
PORT=8000
HOST=0.0.0.0

# ── Security & JWT ───────────────────────────────────────────────────────────
# Generate a secure 32+ character random key in production
SECRET_KEY=yugioh-collector-super-secret-key-change-in-production-2026-xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yugioh_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/yugioh_db

# ── Cache & Rate Limiting (Redis) ────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDis_URL=redis://redis:6379/0

# ── YGOPRODeck External API ──────────────────────────────────────────────────
YGOPRODECK_BASE_URL=https://db.ygoprodeck.com/api/v7
YGOPRODECK_RATE_LIMIT_RPS=1.0
YGOPRODECK_TIMEOUT_SECONDS=30

# ── SQLite Lite Export (Mobile DB) ───────────────────────────────────────────
SQLITE_EXPORT_DIR=/app/data
SQLITE_DB_NAME=yugioh_lite.db

# ── Internal Service Key ─────────────────────────────────────────────────────
# Used to authenticate internal cron triggers / manual sync endpoints
ADMIN_SERVICE_KEY=secret-internal-service-sync-key-2026
